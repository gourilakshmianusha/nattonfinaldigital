SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# New admin server configuration; reuse the same existing Supabase project.
# Never prefix server secrets with VITE_.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ORIGIN=
ADMIN_RECOVERY_REDIRECT=
ND_ADMIN_LEAD_INGESTION_ENABLED=false
ND_ADMIN_PUBLIC_SITEMAP_ENABLED=false
ND_ADMIN_WEBHOOK_SECRET=

# Optional read-only provider adapters. Configure only approved credentials.
# These server secrets are never returned by the API or stored in browser records.
ND_ADMIN_GA4_TOKEN=
ND_ADMIN_GSC_TOKEN=
ND_ADMIN_GOOGLE_ADS_TOKEN=
ND_ADMIN_GOOGLE_ADS_DEVELOPER_TOKEN=
ND_ADMIN_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
ND_ADMIN_GOOGLE_ADS_VERSION=
ND_ADMIN_META_ADS_TOKEN=
ND_ADMIN_META_GRAPH_VERSION=
ND_ADMIN_GHL_TOKEN=
ND_ADMIN_GHL_VERSION=
ND_ADMIN_N8N_TOKEN=
ND_ADMIN_N8N_BASE_URL=
ND_ADMIN_EMAIL_TOKEN=
ND_ADMIN_WHATSAPP_TOKEN=

# Free Growth Tools: same Supabase project as the admin, Node 22.18+ / 24 recommended.
# Generate a scoped key with scripts/admin/growth-storage-key.mjs.
# Apply its HASH SQL on the target database and inject the key into server secrets.
# Never prefix this or provider keys with VITE_.
ND_GROWTH_INGEST_KEY=
# Optional existing authorised Google Cloud credentials; no APIs or billing are enabled automatically.
GOOGLE_PSI_KEY=
GOOGLE_CRUX_KEY=

# Optional visitor-authorized Search Console for SEO + AEO Audit only.
# Enable Search Console API in your Google Cloud project and register the exact callback.
# Never use VITE_ prefixes for client secret/session keys.
SEO_GSC_CLIENT_ID=
SEO_GSC_CLIENT_SECRET=
# e.g. https://your-domain.com/api/tools/seo-aeo/search-console/callback
SEO_GSC_REDIRECT_URI=
# Install the server browser in each deployment: npx playwright install --with-deps chromium
