{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/prerender-seo-pages.mjs && vite build --ssr src/reference-site/entry-server.jsx --outDir .reference-ssr && node scripts/prerender-reference.mjs",
    "preview": "vite preview",
    "start": "npm run check:growth && node server.mjs",
    "check:growth": "node scripts/admin/check-growth-deployment.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:frontend": "node --test tests/frontend/*.test.mjs && node scripts/verify-reference.mjs",
    "dev:admin": "node scripts/admin/dev.mjs",
    "test:admin": "node --test tests/admin/*.test.mjs",
    "test:growth": "node --test tests/growth/*.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "1.1.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "framer-motion": "^14.10.1",
    "gsap": "^3.15.1",
    "ipaddr.js": "2.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfkit": "0.17.2",
    "playwright": "1.65.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "serverless-http": "3.2.0",
    "three": "^0.187.0",
    "vite": "^6.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
